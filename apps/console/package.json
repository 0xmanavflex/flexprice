{
  "name": "console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "E2E_REPORT=1 playwright test",
    "test:e2e:journey": "E2E_REPORT=1 playwright test -g",
    "test:e2e:live": "E2E_LIVE=1 E2E_REPORT=1 playwright test e2e/live-",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@csvbox/react": "1.1.14",
    "@fp/domain": "workspace:*",
    "@fp/query": "workspace:*",
    "@fp/ui": "workspace:*",
    "@intercom/messenger-js-sdk": "^0.0.14",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "posthog-js": "1.438.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^30.1.3",
    "msw": "^2.12.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
