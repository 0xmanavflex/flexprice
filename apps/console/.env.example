# Copy to .env.local. Never put a Flexprice API key here — VITE_ variables are
# compiled into the bundle and served to every visitor.

VITE_FLEXPRICE_API_URL=https://api.cloud.flexprice.io/v1

# Local development only, until the auth surface lands.
VITE_DEV_JWT=
VITE_ENVIRONMENT_ID=

# Serve the captured fixture corpus instead of calling a backend.
# Opt-in: a real-integration debug session must never silently get mocks.
VITE_USE_MOCKS=true

# The current dashboard, for the migration placeholders to hand off to.
# Unset means no hand-off link is offered, which is better than a guessed one.
VITE_LEGACY_CONSOLE_URL=
