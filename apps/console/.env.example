# Copy to .env.local (gitignored) and edit. Nothing in THIS file is secret —
# it is committed to a public repository, so every value here is a placeholder.

# ---------------------------------------------------------------------------
# Which Flexprice to talk to
# ---------------------------------------------------------------------------
# Both regions are in the SDK's ServerList. Pick the one your tenant is in:
#   India (default) https://api.cloud.flexprice.io/v1
#   United States   https://us.api.flexprice.io/v1
# A self-hosted backend is whatever you run it on, e.g. http://localhost:8080/v1
VITE_FLEXPRICE_API_URL=https://api.cloud.flexprice.io/v1

# ---------------------------------------------------------------------------
# Real backend, or the bundled fixtures?
# ---------------------------------------------------------------------------
# false -> talk to VITE_FLEXPRICE_API_URL above. You sign in at /sign-in with a
#          real Flexprice account, and the console uses that JWT plus the
#          environment you pick from the switcher.
# true  -> serve the captured fixture corpus. No network, no sign-in, no
#          account needed. This is what Storybook and the end-to-end suite run
#          against, and why the sign-in guard is a no-op under mocks.
#
# Leaving VITE_FLEXPRICE_API_URL unset falls back to mocks and says so in the
# browser console, so the app is never simply broken.
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# API-key escape hatch — development only
# ---------------------------------------------------------------------------
# A raw Flexprice API key, sent as `Authorization: Bearer <key>` in place of a
# signed-in JWT. When set, /sign-in is bypassed entirely. Useful for poking at a
# local or staging backend without an account.
#
# It is honoured ONLY when import.meta.env.DEV is true. A production build drops
# it and logs a warning if one was configured — because a VITE_ variable is not
# a secret: Vite substitutes it at build time, so the literal key ends up in a
# JavaScript chunk served to every visitor. An API key is tenant-wide and does
# not expire, so shipping one is handing out write access to billing data.
#
# Never fill this in here. Put it in .env.local, which is gitignored.
VITE_FLEXPRICE_API_KEY=

# ---------------------------------------------------------------------------
# The current dashboard, for the migration placeholders to hand off to.
# Unset means no hand-off link is offered, which is better than a guessed one.
# ---------------------------------------------------------------------------
VITE_LEGACY_CONSOLE_URL=

# ---------------------------------------------------------------------------
# Which hosted region this deployment is
# ---------------------------------------------------------------------------
# in | us | ca. Each region is a separate deployment with its own API, its own
# accounts and its own identity provider, so the region switcher *navigates*
# to another dashboard rather than repointing this one.
#
# Set it per deployment — in Vercel, a plain project environment variable:
#   in.app.flexprice.io  -> VITE_FLEXPRICE_REGION=in
#   app.flexprice.io     -> VITE_FLEXPRICE_REGION=us
#   ca.app.flexprice.io  -> VITE_FLEXPRICE_REGION=ca
#
# Leave it unset for self-hosted, previews and mocks: the console then knows it
# is not one of the hosted set and shows no switcher, which is correct — there
# is nowhere for it to send anyone. When it is unset the origin is still
# checked, so a deployment that forgets this variable still identifies itself.
VITE_FLEXPRICE_REGION=

# Where each region's dashboard lives. Defaults:
#   in -> https://in.app.flexprice.io
#   us -> https://app.flexprice.io      (us.app.flexprice.io is accepted as an alias)
#   ca -> https://ca.app.flexprice.io
#
# Override as JSON, partially — the entries you leave out keep their default:
#   VITE_FLEXPRICE_REGION_URLS={"us":"https://us.app.flexprice.io"}
#
# The unprefixed US host is the canonical one because that is what the OAuth
# redirect URIs are registered against; changing it means re-registering them.
VITE_FLEXPRICE_REGION_URLS=

# ---------------------------------------------------------------------------
# Supabase — password reset only
# ---------------------------------------------------------------------------
# The Flexprice API has no password-reset endpoint on any provider: its public
# auth routes are /auth/signup, /auth/login and SAML, and nothing else. So the
# console asks Supabase directly, exactly as the V1 dashboard does.
#
# Scope: requesting a reset email and setting the new password. Sign-in stays
# POST /auth/login and the session stays Flexprice's. supabase-js is configured
# with persistSession and autoRefreshToken OFF so it never becomes a second
# session alongside the real one.
#
# The anon key is publishable by design — it is built for browsers and bounded
# by row-level security. It is still per-project, so it is configuration, not a
# constant. The SERVICE key is a different thing entirely and must never appear
# in any VITE_ variable.
#
# Leave all of these unset for a self-hosted deployment. The console then shows
# no "Forgot password?" link, which is correct: self-hosted has never had reset,
# in V1 either.
#
# !! REDIRECT URLS !!
# Every origin this console is served from must be listed in the Supabase
# project under Authentication -> URL Configuration -> Redirect URLs:
# both region dashboards, http://localhost:5173, and a wildcard for preview
# deployments. A missing entry is NOT an error — GoTrue validates the redirect,
# silently substitutes the project's Site URL when it does not match, and
# returns success. The only symptom is a reset link in someone's inbox pointing
# at the wrong host. The console sends them to <origin>/reset-password.

# Where Supabase sends Google sign-in and confirmation emails back to, when it
# must not be this console's own origin. Staging shares prod's Supabase project,
# which does not allow staging's origin and would fall back to the V1 dashboard
# (admin.flexprice.io), so staging sets this to the V2 production origin:
#   VITE_AUTH_REDIRECT_ORIGIN=https://portal.flexprice.io
# Leave unset everywhere else.
VITE_AUTH_REDIRECT_ORIGIN=

# Single project (self-hosted, or one region only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Per region. India and the US are separate deployments with separate accounts,
# so they are very likely separate Supabase projects — and one project's anon
# key cannot reset a password held by the other. It would not fail loudly: the
# request succeeds against the wrong project and no email is ever sent to a user
# who exists only in the other one. Set these when both regions are offered;
# each falls back to the pair above when left empty.
VITE_SUPABASE_URL_IN=
VITE_SUPABASE_ANON_KEY_IN=
VITE_SUPABASE_URL_US=
VITE_SUPABASE_ANON_KEY_US=

# A shared test account exists for the hosted India region; ask the team for it
# rather than looking for it here. Credentials do not go in a committed file.
