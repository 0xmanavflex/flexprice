# Copy to .env.local (gitignored) and edit. Nothing in THIS file is secret —
# it is committed to a public repository, so every value here is a placeholder.

# ---------------------------------------------------------------------------
# Which Flexprice to talk to
# ---------------------------------------------------------------------------
# Both regions are in the SDK's ServerList. Pick the one your tenant is in:
#   India (default) https://api.cloud.flexprice.io/v1
#   United States   https://us.api.flexprice.io/v1
# A self-hosted backend is whatever you run it on, e.g. http://localhost:8080/v1
VITE_FLEXPRICE_API_URL=https://api.cloud.flexprice.io/v1

# ---------------------------------------------------------------------------
# Real backend, or the bundled fixtures?
# ---------------------------------------------------------------------------
# false -> talk to VITE_FLEXPRICE_API_URL above. You sign in at /sign-in with a
#          real Flexprice account, and the console uses that JWT plus the
#          environment you pick from the switcher.
# true  -> serve the captured fixture corpus. No network, no sign-in, no
#          account needed. This is what Storybook and the end-to-end suite run
#          against, and why the sign-in guard is a no-op under mocks.
#
# Leaving VITE_FLEXPRICE_API_URL unset falls back to mocks and says so in the
# browser console, so the app is never simply broken.
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# API-key escape hatch — development only
# ---------------------------------------------------------------------------
# A raw Flexprice API key, sent as `Authorization: Bearer <key>` in place of a
# signed-in JWT. When set, /sign-in is bypassed entirely. Useful for poking at a
# local or staging backend without an account.
#
# It is honoured ONLY when import.meta.env.DEV is true. A production build drops
# it and logs a warning if one was configured — because a VITE_ variable is not
# a secret: Vite substitutes it at build time, so the literal key ends up in a
# JavaScript chunk served to every visitor. An API key is tenant-wide and does
# not expire, so shipping one is handing out write access to billing data.
#
# Never fill this in here. Put it in .env.local, which is gitignored.
VITE_FLEXPRICE_API_KEY=

# ---------------------------------------------------------------------------
# The current dashboard, for the migration placeholders to hand off to.
# Unset means no hand-off link is offered, which is better than a guessed one.
# ---------------------------------------------------------------------------
VITE_LEGACY_CONSOLE_URL=

# A shared test account exists for the hosted India region; ask the team for it
# rather than looking for it here. Credentials do not go in a committed file.
