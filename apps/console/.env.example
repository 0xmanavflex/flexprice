# Copy to .env.local (gitignored) and edit. Nothing in THIS file is secret —
# it is committed to a public repository, so every value here is a placeholder.

# ---------------------------------------------------------------------------
# Which Flexprice to talk to
# ---------------------------------------------------------------------------
# Both regions are in the SDK's ServerList. Pick the one your tenant is in:
#   India (default) https://api.cloud.flexprice.io/v1
#   United States   https://us.api.flexprice.io/v1
# A self-hosted backend is whatever you run it on, e.g. http://localhost:8080/v1
VITE_FLEXPRICE_API_URL=https://api.cloud.flexprice.io/v1

# ---------------------------------------------------------------------------
# Real backend, or the bundled fixtures?
# ---------------------------------------------------------------------------
# false -> talk to VITE_FLEXPRICE_API_URL above. You sign in at /sign-in with a
#          real Flexprice account, and the console uses that JWT plus the
#          environment you pick from the switcher.
# true  -> serve the captured fixture corpus. No network, no sign-in, no
#          account needed. This is what Storybook and the end-to-end suite run
#          against, and why the sign-in guard is a no-op under mocks.
#
# Leaving VITE_FLEXPRICE_API_URL unset falls back to mocks and says so in the
# browser console, so the app is never simply broken.
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# API-key escape hatch — development only
# ---------------------------------------------------------------------------
# A raw Flexprice API key, sent as `Authorization: Bearer <key>` in place of a
# signed-in JWT. When set, /sign-in is bypassed entirely. Useful for poking at a
# local or staging backend without an account.
#
# It is honoured ONLY when import.meta.env.DEV is true. A production build drops
# it and logs a warning if one was configured — because a VITE_ variable is not
# a secret: Vite substitutes it at build time, so the literal key ends up in a
# JavaScript chunk served to every visitor. An API key is tenant-wide and does
# not expire, so shipping one is handing out write access to billing data.
#
# Never fill this in here. Put it in .env.local, which is gitignored.
VITE_FLEXPRICE_API_KEY=

# ---------------------------------------------------------------------------
# The current dashboard, for the migration placeholders to hand off to.
# Unset means no hand-off link is offered, which is better than a guessed one.
# ---------------------------------------------------------------------------
VITE_LEGACY_CONSOLE_URL=

# ---------------------------------------------------------------------------
# Which hosted region this deployment is
# ---------------------------------------------------------------------------
# in | us | ca. Each region is a separate deployment with its own API, its own
# accounts and its own identity provider, so the region switcher *navigates*
# to another dashboard rather than repointing this one.
#
# Set it per deployment — in Vercel, a plain project environment variable:
#   in.app.flexprice.io  -> VITE_FLEXPRICE_REGION=in
#   app.flexprice.io     -> VITE_FLEXPRICE_REGION=us
#   ca.app.flexprice.io  -> VITE_FLEXPRICE_REGION=ca
#
# Leave it unset for self-hosted, previews and mocks: the console then knows it
# is not one of the hosted set and shows no switcher, which is correct — there
# is nowhere for it to send anyone. When it is unset the origin is still
# checked, so a deployment that forgets this variable still identifies itself.
VITE_FLEXPRICE_REGION=

# Where each region's dashboard lives. Defaults:
#   in -> https://in.app.flexprice.io
#   us -> https://app.flexprice.io      (us.app.flexprice.io is accepted as an alias)
#   ca -> https://ca.app.flexprice.io
#
# Override as JSON, partially — the entries you leave out keep their default:
#   VITE_FLEXPRICE_REGION_URLS={"us":"https://us.app.flexprice.io"}
#
# The unprefixed US host is the canonical one because that is what the OAuth
# redirect URIs are registered against; changing it means re-registering them.
VITE_FLEXPRICE_REGION_URLS=

# ---------------------------------------------------------------------------
# Supabase — password reset only
# ---------------------------------------------------------------------------
# The Flexprice API has no password-reset endpoint on any provider: its public
# auth routes are /auth/signup, /auth/login and SAML, and nothing else. So the
# console asks Supabase directly, exactly as the V1 dashboard does.
#
# Scope: requesting a reset email and setting the new password. Sign-in stays
# POST /auth/login and the session stays Flexprice's. supabase-js is configured
# with persistSession and autoRefreshToken OFF so it never becomes a second
# session alongside the real one.
#
# The anon key is publishable by design — it is built for browsers and bounded
# by row-level security. It is still per-project, so it is configuration, not a
# constant. The SERVICE key is a different thing entirely and must never appear
# in any VITE_ variable.
#
# Leave all of these unset for a self-hosted deployment. The console then shows
# no "Forgot password?" link, which is correct: self-hosted has never had reset,
# in V1 either.
#
# !! REDIRECT URLS !!
# Every origin this console is served from must be listed in the Supabase
# project under Authentication -> URL Configuration -> Redirect URLs:
# both region dashboards, http://localhost:5173, and a wildcard for preview
# deployments. A missing entry is NOT an error — GoTrue validates the redirect,
# silently substitutes the project's Site URL when it does not match, and
# returns success. The only symptom is a reset link in someone's inbox pointing
# at the wrong host. The console sends them to <origin>/reset-password.

# Where Supabase sends Google sign-in and confirmation emails back to, when it
# must not be this console's own origin. Staging shares prod's Supabase project,
# which does not allow staging's origin and would fall back to the V1 dashboard
# (admin.flexprice.io), so staging sets this to the V2 production origin:
#   VITE_AUTH_REDIRECT_ORIGIN=https://portal.flexprice.io
# Leave unset everywhere else.
VITE_AUTH_REDIRECT_ORIGIN=

# Single project (self-hosted, or one region only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Per region. India, the US and Canada are separate deployments with separate accounts,
# so they are very likely separate Supabase projects — and one project's anon
# key cannot reset a password held by the other. It would not fail loudly: the
# request succeeds against the wrong project and no email is ever sent to a user
# who exists only in the other one. Set these when both regions are offered;
# each falls back to the pair above when left empty.
VITE_SUPABASE_URL_IN=
VITE_SUPABASE_ANON_KEY_IN=
VITE_SUPABASE_URL_US=
VITE_SUPABASE_ANON_KEY_US=
VITE_SUPABASE_URL_CA=
VITE_SUPABASE_ANON_KEY_CA=

# A shared test account exists for the hosted India region; ask the team for it
# rather than looking for it here. Credentials do not go in a committed file.

# ---------------------------------------------------------------------------
# Platform config — one JSON value, same name and keys as V1. Every key is
# optional; leave one out for its default. Unused V1 keys are ignored.
#   production.enabled   create production environments here (default false;
#                        when false, asking for one shows the contact options)
#   contact_us           Slack / Email / Book a call in Create environment.
#                        Each defaults to Flexprice's own; "" hides one,
#                        "enabled": false hides them all (white-label).
# ---------------------------------------------------------------------------
# VITE_PLATFORM_CONFIG={"production":{"enabled":false},"contact_us":{"enabled":true,"slack_url":"https://join.slack.com/t/your-workspace/shared_invite/…","email":"support@example.com","book_call_url":"https://calendly.com/your-team/30min"}}
VITE_PLATFORM_CONFIG=

# ---------------------------------------------------------------------------
# Support chat — the Help button and "Open …" in the command palette.
# Enable AT MOST ONE provider. If both are enabled, Intercom wins and Pylon is
# ignored (a warning is logged in non-production builds). Same as V1.
# ---------------------------------------------------------------------------
# Intercom. VITE_APP_INTERCOM_APP_ID (V1's older name) still works as a fallback.
VITE_INTERCOM_ENABLED=false
VITE_INTERCOM_APP_ID=

# Pylon — https://docs.usepylon.com/pylon-docs/chat-widget/chat-setup
# The app id comes from the Pylon dashboard under Chat Widget settings, and may
# hold only letters, digits, hyphens and underscores.
# Identity verification is optional. Enable it only when "HMAC email hash" is on
# in the Pylon dashboard; the backend signs it at POST /users/chat/verify
# (chat_support.identity_secret must match). When false, email_hash is omitted.
VITE_PYLON_ENABLED=false
VITE_PYLON_APP_ID=
VITE_PYLON_IDENTITY_VERIFICATION_ENABLED=false

# ---------------------------------------------------------------------------
# Product analytics — PostHog, same variables as V1
# ---------------------------------------------------------------------------
# Off unless VITE_POSTHOG_ENABLED=true AND a key is set, and never under mocks,
# so local runs, previews without it, Storybook and the E2E suite send nothing.
# posthog-js is only downloaded when it is on.
#
# One PostHog project per deployment: set these in each region's Vercel project
# (in / us / ca), pointing at that region's PostHog project or the shared one.
# Every event carries `region`, `app` and `app_version`, so a shared project can
# still be split by region.
#
# The key is PostHog's public, write-only project key (phc_…): it is meant to
# be in the browser and is not a secret. Never put a personal API key (phx_…)
# here. VITE_APP_PUBLIC_POSTHOG_KEY / _HOST (V1's older names) still work.
#
# Host: https://us.i.posthog.com (US cloud, the default) or
#       https://eu.i.posthog.com (EU cloud), or your reverse proxy.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Marketplace integrations — same variables and values as V1
# ---------------------------------------------------------------------------
# Flexprice's own AWS account ID and the role it meters from. The AWS
# Marketplace connect sheet puts the account in the trust policy the customer
# creates; the GCP Marketplace sheet puts both in its gcloud federation script.
# Public identifiers, not secrets. Set per region on each Vercel project (each
# region's backend assumes roles from its own account). Unset, both sheets say
# the setup details are missing instead of showing a policy.
VITE_FLEXPRICE_AWS_ACCOUNT_ID=
VITE_FLEXPRICE_AWS_ROLE_NAME=

# ---------------------------------------------------------------------------
# Onboarding sheet — same variable and value as V1
# ---------------------------------------------------------------------------
# The Google Apps Script web app (https://script.google.com/macros/s/…/exec)
# that appends one row per completed onboarding: orgName, orgUrl,
# referralSource, userEmail, tenantId, timestamp. Set it per region on each
# Vercel project. Unset, onboarding still completes and the missed row is
# logged to the console as an error. Ignored under mocks.
#
# The URL is public by design (Apps Script web apps run as their owner); it
# carries no Google credentials. If the account that owns the deployment is
# removed, Apps Script answers HTTP 200 with a "No such user" page, which the
# console detects and reports rather than treating as written.
VITE_GOOGLE_SHEETS_WEB_APP_URL=

# ---------------------------------------------------------------------------
# Public surfaces (hosted invoice and customer portal; later checkout)
# ---------------------------------------------------------------------------
# One deployment serves the console AND the public pages. The hostname picks
# which one boots (src/surfaces/surface.ts):
#   invoice.flexprice.io (or invoices.)  the hosted invoice page
#   portal.flexprice.io (or billing.)    the customer portal
# Any other host is the console, where /i/<region>/<token> opens an invoice and
# /p/<region>?token=... opens the portal (that is how it works on localhost,
# previews and admin-dev).
#
# Hosts per surface, replacing the defaults for the surfaces named:
#   VITE_SURFACE_HOSTS={"invoice":["invoice-dev.flexprice.io"],"portal":["portal-dev.flexprice.io"]}
VITE_SURFACE_HOSTS=
#
# The API for each region named in a public link (/us/<token>, /us?token=...):
# the browser calls that region directly; there is no edge router. Origins
# only (no /v1). No defaults: a region left out has no page.
#   VITE_PUBLIC_API_URLS={"us":"https://us.api.flexprice.io","in":"https://api.cloud.flexprice.io","ca":"https://canada.api.flexprice.io"}
# On dev, the links say /in but must reach the dev API:
#   VITE_PUBLIC_API_URLS={"in":"https://api-dev.cloud.flexprice.io"}
#
# Regional deployments: a domain belongs to ONE Vercel project, and one is
# enough. Attach invoice.flexprice.io (and portal.flexprice.io) to a single
# project and set VITE_PUBLIC_API_URLS there, listing EVERY region: the link
# names its region and the browser calls that region's API directly, so each
# region's data never leaves its own API. Leave it unset in the other regional
# projects; they get no public-page traffic, and /i/... there shows "Invoice
# not found".
# This is separate from VITE_FLEXPRICE_REGION / VITE_FLEXPRICE_API_URL, which
# stay per project and only decide which API this console talks to.
# Each backend region points its links at the same domains:
#   FLEXPRICE_HOSTED_INVOICE_BASE_URL=https://invoice.flexprice.io/<region>
#   FLEXPRICE_CUSTOMER_PORTAL_URL=https://portal.flexprice.io/<region>
# (the portal API appends ?token=...; the portal moves it into session storage
# and out of the address bar on load).
# With VITE_USE_MOCKS=true the portal is served by src/mocks/portalHandlers.ts:
# open /p/us?token=demo (or ?token=expired).
VITE_PUBLIC_API_URLS=
