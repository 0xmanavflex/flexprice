{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ui/*": [
        "../../packages/ui/src/*"
      ],
      "lucide-react": [
        "../../packages/ui/src/icons/index.ts"
      ]
    },
    "noEmit": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
