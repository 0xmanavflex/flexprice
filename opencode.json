{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "reui": {
      "type": "remote",
      "url": "https://mcp.reui.io/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:REUI_LICENSE_KEY}"
      }
    },
    "nx-mcp": {
      "type": "local",
      "command": ["npx", "nx", "mcp"],
      "enabled": true
    }
  }
}
