{
  "name": "@fp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Presentation only. No server state, no SDK, no transport types.",
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/components/primitives/index.ts",
    "./compositions": "./src/compositions/index.ts",
    "./pages": "./src/pages/index.ts",
    "./icons": "./src/icons/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "vendor:suppress": "node scripts/vendor-suppress.mjs",
    "ui:add": "node scripts/add.mjs",
    "icons:sync": "node scripts/icons-sync.mjs",
    "anatomy": "node ../../scripts/storybook-anatomy.mjs",
    "storybook": "pnpm anatomy && storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm anatomy && storybook build --output-dir dist/storybook --quiet",
    "test:stories": "vitest run --project=storybook"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fp/domain": "workspace:*",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@hookform/resolvers": "^5.4.0",
    "@lucasmarkes/hairline": "0.5.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "countrycitystatejson": "26.9.2802",
    "date-fns": "^4.4.0",
    "motion": "^13.4.1",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.4.299",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.78.0",
    "react-svg-credit-card-payment-icons": "6.0.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "react": "^19.2.6",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
